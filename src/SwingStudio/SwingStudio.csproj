<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\SwingStudio.ico</ApplicationIcon>
    <Version>1.0.3</Version>
    <Product>SwingStudio</Product>
    <Company>Matt Cecile</Company>
  </PropertyGroup>

  <Target Name="SuppressOpenCvSharpAnalyzer" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'OpenCvSharp.Analyzers'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Resource Include="Assets\SwingStudio.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="OpenCvSharp5" Version="5.0.0.20260905">
      <ExcludeAssets>analyzers</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="OpenCvSharp5.runtime.win" Version="5.0.0.20260905" />
    <PackageReference Include="OpenCvSharp5.WpfExtensions" Version="5.0.0.20260905" />
  </ItemGroup>

</Project>
