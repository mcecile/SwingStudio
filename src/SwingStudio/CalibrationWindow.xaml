<Window x:Class="SwingStudio.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrate trigger"
        Width="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="Assets/SwingStudio.ico"
        Background="#1E1E1E">
    <StackPanel Margin="20">
        <TextBlock x:Name="Prompt" Foreground="#E6E6E6" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Detail" Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,6,0,12" />

        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="Above 2 kHz" Foreground="#C8C8C8" VerticalAlignment="Center" Width="72" />
            <TextBlock x:Name="LevelValue" DockPanel.Dock="Right" Foreground="#E6E6E6" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
            <ProgressBar x:Name="Level" Height="10" Minimum="0" Maximum="100" AutomationProperties.Name="Calibration mic level" />
        </DockPanel>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="RoomStatus" Foreground="#C8C8C8" Margin="0,4" Text="Room noise: not recorded" />
            <TextBlock x:Name="Swing1Status" Grid.Row="1" Foreground="#C8C8C8" Margin="0,4" Text="Swing 1: not recorded" />
            <Button x:Name="Redo1" Grid.Row="1" Grid.Column="1" Content="Redo" Width="72" Margin="0,2" IsEnabled="False" Click="Redo_Click" Tag="0" AutomationProperties.Name="Redo swing 1" />
            <TextBlock x:Name="Swing2Status" Grid.Row="2" Foreground="#C8C8C8" Margin="0,4" Text="Swing 2: not recorded" />
            <Button x:Name="Redo2" Grid.Row="2" Grid.Column="1" Content="Redo" Width="72" Margin="0,2" IsEnabled="False" Click="Redo_Click" Tag="1" AutomationProperties.Name="Redo swing 2" />
            <TextBlock x:Name="Swing3Status" Grid.Row="3" Foreground="#C8C8C8" Margin="0,4" Text="Swing 3: not recorded" />
            <Button x:Name="Redo3" Grid.Row="3" Grid.Column="1" Content="Redo" Width="72" Margin="0,2" IsEnabled="False" Click="Redo_Click" Tag="2" AutomationProperties.Name="Redo swing 3" />
        </Grid>

        <StackPanel x:Name="ReviewPanel" Visibility="Collapsed">
            <Border Background="#141414" BorderBrush="#333333" BorderThickness="1" Height="190" Margin="0,0,0,6">
                <Canvas x:Name="Chart" ClipToBounds="True" SizeChanged="Chart_SizeChanged" />
            </Border>
            <TextBlock Foreground="#7A7A7A" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Each panel is one swing (0-100 meter scale). Gray: loudest room sound. Gold: proposed threshold. Ticks: detected sounds, gold for the strike." />
            <TextBlock x:Name="Summary" Foreground="#E6E6E6" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="Warnings" Foreground="#F0B060" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="Notes" Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="SavedTo" Foreground="#7A7A7A" TextWrapping="Wrap" Margin="0,0,0,6" />
        </StackPanel>

        <DockPanel Margin="0,8,0,0">
            <Button x:Name="ActionButton" DockPanel.Dock="Left" Content="Start" Width="120" Click="Action_Click" AutomationProperties.Name="Calibration action" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="88" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="ApplyButton" Content="Apply" Width="88" IsEnabled="False" Click="Apply_Click" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
