<Window x:Class="SwingStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwingStudio"
        Height="800"
        Width="1280"
        MinHeight="480"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#454545" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6A6A6A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CameraGearButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Camera settings" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#CC2A2A2A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6E6E6E" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Chrome" Property="Background" Value="#332A2A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlaybackButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#454545" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6E6E6E" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#252526" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Live" Foreground="#C8C8C8" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusDetail" Margin="16,0,0,0" Foreground="#9A9A9A" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" Padding="4,2" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                    <TextBlock Text="Microphone" Foreground="#C8C8C8" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="MicrophoneList" Width="240" VerticalAlignment="Center" AutomationProperties.Name="Microphone"
                              SelectionChanged="MicrophoneList_SelectionChanged" PreviewMouseLeftButtonDown="MicrophoneList_PreviewMouseLeftButtonDown" />
                    <ProgressBar x:Name="MicrophoneLevel" Width="72" Height="8" Margin="12,0,0,0" Minimum="0" Maximum="100" Value="0"
                                 Foreground="#6FCF97" Background="#3A3A3A" BorderThickness="0" VerticalAlignment="Center"
                                 AutomationProperties.Name="Microphone level" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Click="SaveSwing_Click" AutomationProperties.Name="Save Swing">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE74E;" HorizontalAlignment="Center" />
                        <TextBlock Text="Save Swing" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" MinWidth="120" Click="PlaybackSpeed_Click" AutomationProperties.Name="Playback Speed">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE102;" HorizontalAlignment="Center" />
                        <TextBlock x:Name="PlaybackSpeedValue" Text="1/1" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Playback Speed" FontSize="11" Foreground="#9A9A9A" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" MinWidth="88" Click="Replay_Click" AutomationProperties.Name="Replay">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE1CD;" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ReplayValue" Text="2x" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Replay" FontSize="11" Foreground="#9A9A9A" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Settings_Click" AutomationProperties.Name="Settings">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE713;" HorizontalAlignment="Center" />
                        <TextBlock Text="Settings" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="CameraRow" Height="3*" MinHeight="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="PressureRow" Height="*" MinHeight="80" />
            </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        <Grid x:Name="VideoSplit" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPaneColumn" Width="*" MinWidth="160" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Border Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Image x:Name="CameraAImage" Stretch="Uniform" />
                        <TextBlock x:Name="CameraAStats" Margin="12" VerticalAlignment="Bottom" Foreground="#C8C8C8" />
                        <StackPanel x:Name="CameraAPicker" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Camera A" Foreground="#9A9A9A" HorizontalAlignment="Center" FontSize="16" />
                            <ComboBox x:Name="CameraAList" Width="280" Margin="0,12,0,0" DisplayMemberPath="Name"
                                      SelectionChanged="CameraAList_SelectionChanged" PreviewMouseLeftButtonDown="CameraList_PreviewMouseLeftButtonDown" />
                            <TextBlock x:Name="CameraAMessage" Width="280" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="#C8C8C8" />
                        </StackPanel>
                        <Button x:Name="CameraASettings" Style="{StaticResource CameraGearButton}" IsEnabled="False" Click="CameraASettings_Click" AutomationProperties.Name="Camera A settings" Panel.ZIndex="2">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;" />
                        </Button>
                    </Grid>
                </Border>
                <Canvas x:Name="CameraAOverlay" IsHitTestVisible="False" />
            </Grid>

            <GridSplitter x:Name="PaneSplitter"
                          Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Background="#3A3A3A"
                          DragCompleted="PaneSplitter_DragCompleted" />

            <Grid Grid.Column="2">
                <Border Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Image x:Name="CameraBImage" Stretch="Uniform" />
                        <TextBlock x:Name="CameraBStats" Margin="12" VerticalAlignment="Bottom" Foreground="#C8C8C8" />
                        <StackPanel x:Name="CameraBPicker" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Camera B" Foreground="#9A9A9A" HorizontalAlignment="Center" FontSize="16" />
                            <ComboBox x:Name="CameraBList" Width="280" Margin="0,12,0,0" DisplayMemberPath="Name"
                                      SelectionChanged="CameraBList_SelectionChanged" PreviewMouseLeftButtonDown="CameraList_PreviewMouseLeftButtonDown" />
                            <TextBlock x:Name="CameraBMessage" Width="280" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="#C8C8C8" />
                        </StackPanel>
                        <Button x:Name="CameraBSettings" Style="{StaticResource CameraGearButton}" IsEnabled="False" Click="CameraBSettings_Click" AutomationProperties.Name="Camera B settings" Panel.ZIndex="2">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;" />
                        </Button>
                    </Grid>
                </Border>
                <Canvas x:Name="CameraBOverlay" IsHitTestVisible="False" />
            </Grid>
        </Grid>
            <Border Grid.Row="1" Margin="0,8,0,0" Padding="8,4" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="SwingList" Width="200" Margin="4,0,8,0" VerticalAlignment="Center"
                                  DisplayMemberPath="Label" SelectionChanged="SwingList_SelectionChanged"
                                  AutomationProperties.Name="Swing" />
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlaybackButton}" IsEnabled="False" Click="PlayPause_Click" ToolTip="Play" AutomationProperties.Name="Play">
                            <TextBlock x:Name="PlayPauseIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE102;" />
                        </Button>
                        <Button x:Name="BackFrameButton" Style="{StaticResource PlaybackButton}" IsEnabled="False" Click="BackFrame_Click" ToolTip="Back frame" AutomationProperties.Name="Back frame">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE76B;" />
                        </Button>
                        <Button x:Name="ForwardFrameButton" Style="{StaticResource PlaybackButton}" IsEnabled="False" Click="ForwardFrame_Click" ToolTip="Forward frame" AutomationProperties.Name="Forward frame">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE76C;" />
                        </Button>
                    </StackPanel>
                    <Slider x:Name="PlaybackSlider" Margin="12,0,4,0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                            IsEnabled="False" IsMoveToPointEnabled="True" ValueChanged="PlaybackSlider_ValueChanged"
                            AutomationProperties.Name="Playback position" />
                </DockPanel>
            </Border>
        </Grid>

            <GridSplitter x:Name="RowSplitter"
                          Grid.Row="1"
                          Height="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          ShowsPreview="False"
                          Background="#3A3A3A"
                          DragCompleted="PaneSplitter_DragCompleted" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FootMapColumn" Width="*" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="WeightColumn" Width="*" MinWidth="140" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                    <TextBlock Text="Foot map" Foreground="#9A9A9A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                </Border>

                <GridSplitter x:Name="PressureSplitter"
                              Grid.Column="1"
                              Width="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"
                              ShowsPreview="False"
                              Background="#3A3A3A"
                              DragCompleted="PaneSplitter_DragCompleted" />

                <Border Grid.Column="2" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                    <TextBlock Text="Weight transfer" Foreground="#9A9A9A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                </Border>
            </Grid>
        </Grid>

        </Grid>
    </DockPanel>
</Window>
