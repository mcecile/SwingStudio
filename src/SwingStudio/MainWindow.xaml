<Window x:Class="SwingStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        Title="SwingStudio"
        Height="800"
        Width="1280"
        MinHeight="480"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/SwingStudio.ico"
        Background="#1E1E1E">
    <Window.Resources>
        <SolidColorBrush x:Key="ChromeOrange" Color="#FF9A1F" />
        <DropShadowEffect x:Key="OrangeGlow" po:Freeze="True" Color="#FF6A00" BlurRadius="10" ShadowDepth="0" Opacity="0.66" />
        <DropShadowEffect x:Key="WordEdge" po:Freeze="True" Color="#1A120C" BlurRadius="3" ShadowDepth="0" Opacity="0.95" />
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ChromeOrange}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Effect>
                                    <StaticResource ResourceKey="OrangeGlow" />
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#454545" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChromeOrange}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CameraGearButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ChromeOrange}" />
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Camera settings" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Effect>
                                    <StaticResource ResourceKey="OrangeGlow" />
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#CC2A2A2A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6E6E6E" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Chrome" Property="Background" Value="#332A2A2A" />
                                <Setter TargetName="Glyph" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DrawSwatch" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Width="16" Height="16" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DrawToolButton" TargetType="Button" BasedOn="{StaticResource CameraGearButton}">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#CC2A2A2A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6E6E6E" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Chrome" Property="Background" Value="#332A2A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlaybackButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ChromeOrange}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Effect>
                                    <StaticResource ResourceKey="OrangeGlow" />
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#454545" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6E6E6E" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Glyph" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderBar" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlaybackSlider" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="Played" Background="{StaticResource ChromeOrange}" Style="{StaticResource SliderBar}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Background="#3A3A3A" Style="{StaticResource SliderBar}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" VerticalAlignment="Center">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="ThumbEllipse" Fill="{StaticResource ChromeOrange}">
                                                <Ellipse.Effect>
                                                    <StaticResource ResourceKey="OrangeGlow" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ThumbEllipse" Property="Fill" Value="#6E6E6E" />
                                                    <Setter TargetName="ThumbEllipse" Property="Effect" Value="{x:Null}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Played" Property="Background" Value="#6E6E6E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#252526" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Live" Foreground="{StaticResource ChromeOrange}" Effect="{StaticResource OrangeGlow}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusDetail" Margin="16,0,0,0" Foreground="{StaticResource ChromeOrange}" Effect="{StaticResource OrangeGlow}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" Padding="4,2" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                    <StackPanel x:Name="MicrophoneWidgets" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Microphone" Foreground="{StaticResource ChromeOrange}" Effect="{StaticResource OrangeGlow}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="MicrophoneList" Width="240" VerticalAlignment="Center" AutomationProperties.Name="Microphone"
                                  SelectionChanged="MicrophoneList_SelectionChanged" PreviewMouseLeftButtonDown="MicrophoneList_PreviewMouseLeftButtonDown" />
                        <ProgressBar x:Name="MicrophoneLevel" Width="72" Height="8" Margin="12,0,0,0" Minimum="0" Maximum="100" Value="0"
                                     Foreground="#6FCF97" Background="#3A3A3A" BorderThickness="0" VerticalAlignment="Center"
                                     ToolTip="Microphone level above 2 kHz"
                                     AutomationProperties.Name="Microphone level" />
                    </StackPanel>
                    <TextBlock x:Name="AppVersion" Margin="16,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource ChromeOrange}" Effect="{StaticResource OrangeGlow}" FontSize="12"
                               AutomationProperties.Name="Version" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                <Viewbox Height="{Binding ActualHeight, ElementName=ToolButtons}" Stretch="Uniform" Margin="0,0,2,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid Width="112" Height="72" ToolTip="Swing Studio">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock Text="Swing" FontFamily="Gabriola" FontSize="32" Foreground="White"
                                       Effect="{StaticResource WordEdge}" HorizontalAlignment="Center" Margin="0,0,0,-16" />
                            <TextBlock Text="Studio" FontFamily="Gabriola" FontSize="32" Foreground="Transparent"
                                       HorizontalAlignment="Center" Margin="0,-14,0,0" />
                        </StackPanel>
                        <Image Source="/Assets/swoop.png" Stretch="Uniform" IsHitTestVisible="False">
                            <Image.OpacityMask>
                                <VisualBrush Stretch="Fill">
                                    <VisualBrush.Visual>
                                        <Grid Width="112" Height="72" Background="Transparent">
                                            <Path x:Name="BrandSwoopDraw" Stroke="White" StrokeThickness="26"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  StrokeDashArray="100 100" StrokeDashOffset="100"
                                                  Data="M 7.2,13.9 L 10.4,14.9 L 13.6,16 L 16.8,20.3 L 20,25.6 L 23.2,30.4 L 26.4,35.2 L 29.6,38.9 L 32.8,42.7 L 36,45.9 L 39.2,49.1 L 42.4,52.3 L 45.6,54.9 L 48.8,57.6 L 52,59.7 L 55.2,60.8 L 58.4,61.9 L 61.6,62.9 L 64.8,62.4 L 68,61.9 L 71.2,60.8 L 74.4,58.7 L 77.6,56.5 L 80.8,53.3 L 84,50.1 L 87.2,46.9 L 90.4,42.1 L 93.6,36.8 L 96.8,30.9 L 100,24.5 L 103.2,16.5 L 106.4,5.9" />
                                        </Grid>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Image.OpacityMask>
                        </Image>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" IsHitTestVisible="False">
                            <TextBlock Text="Swing" FontFamily="Gabriola" FontSize="32" Foreground="Transparent"
                                       HorizontalAlignment="Center" Margin="0,0,0,-16" />
                            <TextBlock Text="Studio" FontFamily="Gabriola" FontSize="32" Foreground="White"
                                       Effect="{StaticResource WordEdge}" HorizontalAlignment="Center" Margin="0,-14,0,0" />
                        </StackPanel>
                    </Grid>
                </Viewbox>
                <StackPanel x:Name="ToolButtons" Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Click="SaveSwing_Click" AutomationProperties.Name="Save Swing">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE74E;" HorizontalAlignment="Center" />
                        <TextBlock Text="Save Swing" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" MinWidth="120" Click="PlaybackSpeed_Click" AutomationProperties.Name="Playback Speed">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE102;" HorizontalAlignment="Center" />
                        <TextBlock x:Name="PlaybackSpeedValue" Text="1/1" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Playback Speed" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" MinWidth="88" Click="Replay_Click" AutomationProperties.Name="Replay">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE1CD;" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ReplayValue" Text="2x" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Replay" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Settings_Click" AutomationProperties.Name="Settings">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE713;" HorizontalAlignment="Center" />
                        <TextBlock Text="Settings" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="CameraRow" Height="3*" MinHeight="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="PressureRow" Height="*" MinHeight="80" />
            </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        <Grid x:Name="VideoSplit" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPaneColumn" Width="*" MinWidth="160" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Border Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Image x:Name="CameraAImage" Stretch="Uniform" />
                        <TextBlock x:Name="CameraAStats" Margin="12" VerticalAlignment="Bottom" Foreground="#C8C8C8" />
                        <StackPanel x:Name="CameraAPicker" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Camera A" Foreground="#9A9A9A" HorizontalAlignment="Center" FontSize="16" />
                            <ComboBox x:Name="CameraAList" Width="280" Margin="0,12,0,0" DisplayMemberPath="Name"
                                      SelectionChanged="CameraAList_SelectionChanged" PreviewMouseLeftButtonDown="CameraList_PreviewMouseLeftButtonDown" />
                            <TextBlock x:Name="CameraAMessage" Width="280" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="#C8C8C8" />
                        </StackPanel>
                        <Button x:Name="CameraASettings" Style="{StaticResource CameraGearButton}" IsEnabled="False" Click="CameraASettings_Click" AutomationProperties.Name="Camera A settings" Panel.ZIndex="2">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;" />
                        </Button>
                        <Canvas x:Name="CameraADraw" Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="1"
                                MouseLeftButtonDown="Draw_MouseDown" MouseMove="Draw_MouseMove" MouseLeftButtonUp="Draw_MouseUp" />
                    </Grid>
                </Border>
                <Canvas x:Name="CameraAOverlay" IsHitTestVisible="False" />
                <StackPanel x:Name="CameraATools" Margin="8,48,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="3">
                    <StackPanel x:Name="CameraAColors">
                        <Button Style="{StaticResource DrawSwatch}" Background="#FFE08A" Tag="#FFE08A" Click="DrawColor_Click" ToolTip="Yellow" AutomationProperties.Name="Camera A yellow" />
                        <Button Style="{StaticResource DrawSwatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="DrawColor_Click" ToolTip="White" AutomationProperties.Name="Camera A white" />
                        <Button Style="{StaticResource DrawSwatch}" Background="#FF5A5A" Tag="#FF5A5A" Click="DrawColor_Click" ToolTip="Red" AutomationProperties.Name="Camera A red" />
                        <Button Style="{StaticResource DrawSwatch}" Background="#5AC8FF" Tag="#5AC8FF" Click="DrawColor_Click" ToolTip="Cyan" AutomationProperties.Name="Camera A cyan" />
                    </StackPanel>
                    <Button x:Name="CameraACircle" Style="{StaticResource DrawToolButton}" Tag="circle" Click="DrawTool_Click" ToolTip="Circle" AutomationProperties.Name="Camera A circle">
                        <Ellipse Width="14" Height="14" Stroke="White" StrokeThickness="1.5" />
                    </Button>
                    <Button x:Name="CameraALine" Style="{StaticResource DrawToolButton}" Tag="line" Click="DrawTool_Click" ToolTip="Line" AutomationProperties.Name="Camera A line">
                        <Path Stroke="White" StrokeThickness="1.5" Data="M2,14 L14,2" />
                    </Button>
                    <Button x:Name="CameraAAngle" Style="{StaticResource DrawToolButton}" Tag="angle" Click="DrawTool_Click" ToolTip="Angle" AutomationProperties.Name="Camera A angle">
                        <Path Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M2,14 L8,2 L15,12" />
                    </Button>
                    <Button x:Name="CameraAUndo" Style="{StaticResource DrawToolButton}" Click="DrawUndo_Click" ToolTip="Undo" AutomationProperties.Name="Camera A undo">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE7A7;" />
                    </Button>
                </StackPanel>
            </Grid>

            <GridSplitter x:Name="PaneSplitter"
                          Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Background="#3A3A3A"
                          DragCompleted="PaneSplitter_DragCompleted" />

            <Grid Grid.Column="2">
                <Border Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Image x:Name="CameraBImage" Stretch="Uniform" />
                        <TextBlock x:Name="CameraBStats" Margin="12" VerticalAlignment="Bottom" Foreground="#C8C8C8" />
                        <StackPanel x:Name="CameraBPicker" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Camera B" Foreground="#9A9A9A" HorizontalAlignment="Center" FontSize="16" />
                            <ComboBox x:Name="CameraBList" Width="280" Margin="0,12,0,0" DisplayMemberPath="Name"
                                      SelectionChanged="CameraBList_SelectionChanged" PreviewMouseLeftButtonDown="CameraList_PreviewMouseLeftButtonDown" />
                            <TextBlock x:Name="CameraBMessage" Width="280" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="#C8C8C8" />
                        </StackPanel>
                        <Button x:Name="CameraBSettings" Style="{StaticResource CameraGearButton}" IsEnabled="False" Click="CameraBSettings_Click" AutomationProperties.Name="Camera B settings" Panel.ZIndex="2">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;" />
                        </Button>
                        <Canvas x:Name="CameraBDraw" Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="1"
                                MouseLeftButtonDown="Draw_MouseDown" MouseMove="Draw_MouseMove" MouseLeftButtonUp="Draw_MouseUp" />
                    </Grid>
                </Border>
                <Canvas x:Name="CameraBOverlay" IsHitTestVisible="False" />
                <StackPanel x:Name="CameraBTools" Margin="8,48,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="3">
                    <StackPanel x:Name="CameraBColors">
                        <Button Style="{StaticResource DrawSwatch}" Background="#FFE08A" Tag="#FFE08A" Click="DrawColor_Click" ToolTip="Yellow" AutomationProperties.Name="Camera B yellow" />
                        <Button Style="{StaticResource DrawSwatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="DrawColor_Click" ToolTip="White" AutomationProperties.Name="Camera B white" />
                        <Button Style="{StaticResource DrawSwatch}" Background="#FF5A5A" Tag="#FF5A5A" Click="DrawColor_Click" ToolTip="Red" AutomationProperties.Name="Camera B red" />
                        <Button Style="{StaticResource DrawSwatch}" Background="#5AC8FF" Tag="#5AC8FF" Click="DrawColor_Click" ToolTip="Cyan" AutomationProperties.Name="Camera B cyan" />
                    </StackPanel>
                    <Button x:Name="CameraBCircle" Style="{StaticResource DrawToolButton}" Tag="circle" Click="DrawTool_Click" ToolTip="Circle" AutomationProperties.Name="Camera B circle">
                        <Ellipse Width="14" Height="14" Stroke="White" StrokeThickness="1.5" />
                    </Button>
                    <Button x:Name="CameraBLine" Style="{StaticResource DrawToolButton}" Tag="line" Click="DrawTool_Click" ToolTip="Line" AutomationProperties.Name="Camera B line">
                        <Path Stroke="White" StrokeThickness="1.5" Data="M2,14 L14,2" />
                    </Button>
                    <Button x:Name="CameraBAngle" Style="{StaticResource DrawToolButton}" Tag="angle" Click="DrawTool_Click" ToolTip="Angle" AutomationProperties.Name="Camera B angle">
                        <Path Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M2,14 L8,2 L15,12" />
                    </Button>
                    <Button x:Name="CameraBUndo" Style="{StaticResource DrawToolButton}" Click="DrawUndo_Click" ToolTip="Undo" AutomationProperties.Name="Camera B undo">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE7A7;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
            <Border Grid.Row="1" Margin="0,8,0,0" Padding="8,4" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="SwingList" Width="200" Margin="4,0,8,0" VerticalAlignment="Center"
                                  DisplayMemberPath="Label" SelectionChanged="SwingList_SelectionChanged"
                                  AutomationProperties.Name="Swing" />
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlaybackButton}" IsEnabled="False" Click="PlayPause_Click" ToolTip="Play" AutomationProperties.Name="Play">
                            <TextBlock x:Name="PlayPauseIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE102;" />
                        </Button>
                        <Button x:Name="BackFrameButton" Style="{StaticResource PlaybackButton}" IsEnabled="False" Click="BackFrame_Click" ToolTip="Back frame" AutomationProperties.Name="Back frame">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE76B;" />
                        </Button>
                        <Button x:Name="ForwardFrameButton" Style="{StaticResource PlaybackButton}" IsEnabled="False" Click="ForwardFrame_Click" ToolTip="Forward frame" AutomationProperties.Name="Forward frame">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE76C;" />
                        </Button>
                    </StackPanel>
                    <Slider x:Name="PlaybackSlider" Style="{StaticResource PlaybackSlider}" Margin="12,0,4,0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                            IsEnabled="False" IsMoveToPointEnabled="True" ValueChanged="PlaybackSlider_ValueChanged"
                            AutomationProperties.Name="Playback position" />
                </DockPanel>
            </Border>
        </Grid>

            <GridSplitter x:Name="RowSplitter"
                          Grid.Row="1"
                          Height="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          ShowsPreview="False"
                          Background="#3A3A3A"
                          DragCompleted="PaneSplitter_DragCompleted" />

            <Grid x:Name="PressurePanel" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FootMapColumn" Width="*" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="WeightColumn" Width="*" MinWidth="140" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                    <TextBlock Text="Foot map" Foreground="#9A9A9A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                </Border>

                <GridSplitter x:Name="PressureSplitter"
                              Grid.Column="1"
                              Width="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"
                              ShowsPreview="False"
                              Background="#3A3A3A"
                              DragCompleted="PaneSplitter_DragCompleted" />

                <Border Grid.Column="2" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
                    <TextBlock Text="Weight transfer" Foreground="#9A9A9A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                </Border>
            </Grid>
        </Grid>

        </Grid>
    </DockPanel>
</Window>
